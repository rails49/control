# References, not secrets: `op run --env-file=deploy/op.env` resolves each one
# out of 1Password and puts it in the environment of the command that follows.
# Nothing here is worth hiding, so this file is committed.
#
#   op run --env-file=deploy/op.env -- docker compose -f deploy/compose.yaml up -d
#
# Traefik takes its ACME account from the environment like any other setting
# (TRAEFIK_*), which is what keeps the address out of `compose.yaml`.

CF_DNS_API_TOKEN=op://rails49/Cloudflare DNS/token
TRAEFIK_CERTIFICATESRESOLVERS_LE_ACME_EMAIL=op://rails49/Cloudflare DNS/email
